PORT=3000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# SMTP Configuration (optional - emails log to console if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Tech Store <noreply@yourdomain.com>

# Google Gemini Configuration (FREE - get key at https://aistudio.google.com/apikey)
# Steps: 1) Visit https://aistudio.google.com/apikey 2) Click "Create API key" 3) Copy key and paste below
# IMPORTANT: After editing .env you must restart the backend (npm start / docker compose restart backend)
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative env var name also supported: GOOGLE_API_KEY=...
# Optional model override (default gemini-3.6-flash with auto-fallback to 2.5/1.5). Only change if you know what you're doing.
# GEMINI_MODEL=gemini-3.6-flash
